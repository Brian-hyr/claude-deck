{
  "name": "claude-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Interface enxuta estilo VS Code para o Claude Code local e em servidores SSH",
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:terminal:ui": "node test/e2e/live-terminal.mjs",
    "test:cache:ui": "node test/e2e/prompt-cache.mjs",
    "test:context:ui": "node test/e2e/context-usage.mjs",
    "test:autocompact:ui": "node test/e2e/context-autocompact.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:compat": "node test/e2e/compat-old-server.mjs",
    "test:copy:ui": "node test/e2e/file-copy.mjs",
    "test:copy:remote": "node test/e2e/file-copy.mjs --remote",
    "test:launcher": "powershell -ExecutionPolicy Bypass -File launcher/test-launcher.ps1",
    "icons": "node launcher/generate-icons.mjs",
    "app:open": "powershell -ExecutionPolicy Bypass -File launcher/open-app.ps1",
    "app:stop": "node launcher/stop-server.mjs",
    "test:remote": "node test/e2e/remote.mjs",
    "test:shortcuts": "node test/e2e/shortcuts-headful.mjs",
    "test:memory": "node test/e2e/memory.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run test:e2e && npm run test:e2e:compat && npm run test:remote && npm run test:launcher"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@preact/signals": "^2.11.2",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "preact": "^10.29.8",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
